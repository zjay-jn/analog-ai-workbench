{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aaw.agent.conformance.results/v1alpha1",
  "$comment": "Runtime validation additionally requires exactly one result for every traceability vector, matching harness/stage, and requires later-stage vectors to be NOT_RUN.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "currentStage", "results"],
  "properties": {
    "contractVersion": { "const": "aaw.agent.conformance/v1alpha1" },
    "currentStage": { "enum": ["P4-A", "P4-B", "P4-C", "P4-D"] },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vectorId", "harness", "requiredStage", "status"],
        "properties": {
          "vectorId": { "type": "string", "pattern": "^N(?:0[1-9]|[12][0-9]|30)-[a-z0-9][a-z0-9._-]*$" },
          "harness": { "enum": ["codec", "schema", "c14n", "reducer", "ledger_recovery", "build_gate", "surface_scan", "desktop_boundary", "electron_boundary"] },
          "requiredStage": { "enum": ["P4-A", "P4-B", "P4-C", "P4-D"] },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] }
        }
      }
    }
  }
}
