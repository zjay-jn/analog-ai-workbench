{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aaw.agent.citation-locator/v1alpha1",
  "$comment": "Source-kind compatibility is validated by the runtime source+locator parser: document=text_range|whole_source, artifact=whole_source, reviewed_schematic=schematic_element|whole_source, rag_source=rag_chunk|whole_source.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["locatorKind", "coordinateSystem", "start", "end"],
      "properties": {
        "locatorKind": { "const": "text_range" },
        "coordinateSystem": { "const": "unicode_code_point" },
        "start": { "$ref": "#/$defs/offset" },
        "end": { "$ref": "#/$defs/offset" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["locatorKind", "occurrencePath", "definitionId", "elementKind", "elementId"],
      "properties": {
        "locatorKind": { "const": "schematic_element" },
        "occurrencePath": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/identity" }
        },
        "definitionId": { "$ref": "#/$defs/identity" },
        "elementKind": { "$ref": "#/$defs/identity" },
        "elementId": { "$ref": "#/$defs/identity" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["locatorKind", "chunkId"],
      "properties": {
        "locatorKind": { "const": "rag_chunk" },
        "chunkId": { "$ref": "#/$defs/identity" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["locatorKind"],
      "properties": { "locatorKind": { "const": "whole_source" } }
    }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!latest$)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSystem", "start", "end"],
      "properties": {
        "coordinateSystem": { "const": "unicode_code_point" },
        "start": { "$ref": "#/$defs/offset" },
        "end": { "$ref": "#/$defs/offset" }
      }
    }
  }
}
