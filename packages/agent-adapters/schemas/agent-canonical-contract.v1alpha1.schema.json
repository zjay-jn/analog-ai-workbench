{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aaw.agent.canonical-contract/v1alpha1",
  "oneOf": [
    { "$ref": "#/$defs/canonicalEvent" },
    { "$ref": "#/$defs/sourceMapping" },
    { "$ref": "#/$defs/retryFacts" },
    { "$ref": "#/$defs/toolTransition" }
  ],
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!latest$)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "errorCode": { "enum": ["INVALID_REQUEST", "PROTOCOL_MISMATCH", "CAPABILITY_DENIED", "NOT_CONFIGURED", "ADAPTER_UNAVAILABLE", "UPSTREAM_TIMEOUT", "RATE_LIMITED", "STREAM_INTERRUPTED", "EVENT_GAP", "MALFORMED_EVENT", "CANCELLATION_TIMEOUT", "TOOL_DENIED", "TOOL_FAILED", "RECOVERY_UNSUPPORTED", "REVISION_UNAVAILABLE", "INTERNAL"] },
    "retryability": { "enum": ["never", "safe_resume", "safe_same_request"] },
    "recoveryAction": { "enum": ["none", "reconfigure", "start_new_run", "resume_from_cursor", "retry_same_request"] },
    "documentSource": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "documentId", "revisionId"], "properties": { "sourceKind": { "const": "document" }, "documentId": { "$ref": "#/$defs/identity" }, "revisionId": { "$ref": "#/$defs/identity" } } },
    "artifactSource": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "artifactId", "revisionId"], "properties": { "sourceKind": { "const": "artifact" }, "artifactId": { "$ref": "#/$defs/identity" }, "revisionId": { "$ref": "#/$defs/identity" } } },
    "reviewedSource": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "artifactId", "revisionId"], "properties": { "sourceKind": { "const": "reviewed_schematic" }, "artifactId": { "$ref": "#/$defs/identity" }, "revisionId": { "$ref": "#/$defs/identity" } } },
    "ragSource": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "corpusId", "sourceId", "sourceRevisionId"], "properties": { "sourceKind": { "const": "rag_source" }, "corpusId": { "$ref": "#/$defs/identity" }, "sourceId": { "$ref": "#/$defs/identity" }, "sourceRevisionId": { "$ref": "#/$defs/identity" } } },
    "citationSource": { "oneOf": [{ "$ref": "#/$defs/documentSource" }, { "$ref": "#/$defs/artifactSource" }, { "$ref": "#/$defs/reviewedSource" }, { "$ref": "#/$defs/ragSource" }] },
    "wholeSource": { "type": "object", "additionalProperties": false, "required": ["locatorKind"], "properties": { "locatorKind": { "const": "whole_source" } } },
    "textRange": { "type": "object", "additionalProperties": false, "required": ["locatorKind", "coordinateSystem", "start", "end"], "properties": { "locatorKind": { "const": "text_range" }, "coordinateSystem": { "const": "unicode_code_point" }, "start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "end": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } },
    "span": { "type": "object", "additionalProperties": false, "required": ["coordinateSystem", "start", "end"], "properties": { "coordinateSystem": { "const": "unicode_code_point" }, "start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "end": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } },
    "schematicElement": { "type": "object", "additionalProperties": false, "required": ["locatorKind", "occurrencePath", "definitionId", "elementKind", "elementId"], "properties": { "locatorKind": { "const": "schematic_element" }, "occurrencePath": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identity" } }, "definitionId": { "$ref": "#/$defs/identity" }, "elementKind": { "$ref": "#/$defs/identity" }, "elementId": { "$ref": "#/$defs/identity" } } },
    "ragChunk": { "type": "object", "additionalProperties": false, "required": ["locatorKind", "chunkId"], "properties": { "locatorKind": { "const": "rag_chunk" }, "chunkId": { "$ref": "#/$defs/identity" }, "span": { "$ref": "#/$defs/span" } } },
    "citationLocator": { "oneOf": [{ "$ref": "#/$defs/wholeSource" }, { "$ref": "#/$defs/textRange" }, { "$ref": "#/$defs/schematicElement" }, { "$ref": "#/$defs/ragChunk" }] },
    "preview": { "type": "object", "additionalProperties": false, "required": ["text", "truncated", "authority"], "properties": { "text": { "type": "string", "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" }, "truncated": { "type": "boolean" }, "authority": { "const": "non_authoritative" } }, "$comment": "Runtime also enforces 2048 UTF-8 bytes." },
    "citationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationId", "source", "locator", "authorityStatus", "verificationStatus"],
      "properties": { "citationId": { "$ref": "#/$defs/identity" }, "source": { "$ref": "#/$defs/citationSource" }, "locator": { "$ref": "#/$defs/citationLocator" }, "authorityStatus": { "enum": ["authoritative", "non_authoritative"] }, "verificationStatus": { "enum": ["unverified", "verified", "unavailable"] }, "retrievalId": { "$ref": "#/$defs/identity" }, "preview": { "$ref": "#/$defs/preview" } },
      "allOf": [
        { "if": { "type": "object", "properties": { "source": { "type": "object", "properties": { "sourceKind": { "const": "document" } }, "required": ["sourceKind"] } }, "required": ["source"] }, "then": { "type": "object", "properties": { "locator": { "oneOf": [{ "$ref": "#/$defs/textRange" }, { "$ref": "#/$defs/wholeSource" }] } } } },
        { "if": { "type": "object", "properties": { "source": { "type": "object", "properties": { "sourceKind": { "const": "artifact" } }, "required": ["sourceKind"] } }, "required": ["source"] }, "then": { "type": "object", "properties": { "locator": { "$ref": "#/$defs/wholeSource" } } } },
        { "if": { "type": "object", "properties": { "source": { "type": "object", "properties": { "sourceKind": { "const": "reviewed_schematic" } }, "required": ["sourceKind"] } }, "required": ["source"] }, "then": { "type": "object", "properties": { "locator": { "oneOf": [{ "$ref": "#/$defs/schematicElement" }, { "$ref": "#/$defs/wholeSource" }] } } } },
        { "if": { "type": "object", "properties": { "source": { "type": "object", "properties": { "sourceKind": { "const": "rag_source" } }, "required": ["sourceKind"] } }, "required": ["source"] }, "then": { "type": "object", "properties": { "locator": { "oneOf": [{ "$ref": "#/$defs/ragChunk" }, { "$ref": "#/$defs/wholeSource" }] } } } }
      ]
    },
    "runAcceptedPayload": { "type": "object", "additionalProperties": false, "required": ["conversationId", "turnId", "adapterProfileId", "adapterProfileRevision"], "properties": { "conversationId": { "$ref": "#/$defs/identity" }, "turnId": { "$ref": "#/$defs/identity" }, "adapterProfileId": { "$ref": "#/$defs/identity" }, "adapterProfileRevision": { "$ref": "#/$defs/identity" } } },
    "messagePayload": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string", "maxLength": 4096 } }, "$comment": "Runtime enforces 4096 UTF-8 bytes." },
    "completedPayload": { "type": "object", "additionalProperties": false, "required": ["finishReason"], "properties": { "finishReason": { "const": "completed" } } },
    "cancelledPayload": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "const": "cancelled" } } },
    "failedPayload": { "type": "object", "additionalProperties": false, "required": ["errorCode", "retryability", "recoveryAction"], "properties": { "errorCode": { "$ref": "#/$defs/errorCode" }, "retryability": { "$ref": "#/$defs/retryability" }, "recoveryAction": { "$ref": "#/$defs/recoveryAction" } }, "oneOf": [
      { "properties": { "retryability": { "const": "never" }, "recoveryAction": { "const": "none" } } },
      { "properties": { "retryability": { "const": "never" }, "recoveryAction": { "const": "reconfigure" } } },
      { "properties": { "retryability": { "const": "never" }, "recoveryAction": { "const": "start_new_run" } } },
      { "properties": { "retryability": { "const": "safe_resume" }, "recoveryAction": { "const": "resume_from_cursor" } } },
      { "properties": { "retryability": { "const": "safe_same_request" }, "recoveryAction": { "const": "retry_same_request" } } }
    ] },
    "canonicalEventBase": { "type": "object", "required": ["hostRunId", "eventId", "hostSequence", "acceptedAt", "canonicalPayloadDigest"], "properties": { "hostRunId": { "$ref": "#/$defs/identity" }, "eventId": { "$ref": "#/$defs/identity" }, "hostSequence": { "type": "integer", "minimum": 1, "maximum": 10000 }, "acceptedAt": { "type": "string", "pattern": "^(?!0000)(?:(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)|(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" }, "canonicalPayloadDigest": { "$ref": "#/$defs/sha256" }, "warningCodes": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "SOURCE_TIME_INVALID" } } } },
    "runAcceptedEvent": { "type": "object", "allOf": [{ "$ref": "#/$defs/canonicalEventBase" }, { "type": "object", "required": ["type", "payload"], "properties": { "type": { "const": "run.accepted" }, "payload": { "$ref": "#/$defs/runAcceptedPayload" } } }], "unevaluatedProperties": false },
    "messageEvent": { "type": "object", "allOf": [{ "$ref": "#/$defs/canonicalEventBase" }, { "type": "object", "required": ["type", "payload"], "properties": { "type": { "const": "message.delta" }, "payload": { "$ref": "#/$defs/messagePayload" } } }], "unevaluatedProperties": false },
    "citationEvent": { "type": "object", "allOf": [{ "$ref": "#/$defs/canonicalEventBase" }, { "type": "object", "required": ["type", "payload"], "properties": { "type": { "const": "citation.declared" }, "payload": { "$ref": "#/$defs/citationRef" } } }], "unevaluatedProperties": false },
    "completedEvent": { "type": "object", "allOf": [{ "$ref": "#/$defs/canonicalEventBase" }, { "type": "object", "required": ["type", "payload"], "properties": { "type": { "const": "run.completed" }, "payload": { "$ref": "#/$defs/completedPayload" } } }], "unevaluatedProperties": false },
    "failedEvent": { "type": "object", "allOf": [{ "$ref": "#/$defs/canonicalEventBase" }, { "type": "object", "required": ["type", "payload"], "properties": { "type": { "const": "run.failed" }, "payload": { "$ref": "#/$defs/failedPayload" } } }], "unevaluatedProperties": false },
    "cancelledEvent": { "type": "object", "allOf": [{ "$ref": "#/$defs/canonicalEventBase" }, { "type": "object", "required": ["type", "payload"], "properties": { "type": { "const": "run.cancelled" }, "payload": { "$ref": "#/$defs/cancelledPayload" } } }], "unevaluatedProperties": false },
    "canonicalEvent": { "oneOf": [{ "$ref": "#/$defs/runAcceptedEvent" }, { "$ref": "#/$defs/messageEvent" }, { "$ref": "#/$defs/citationEvent" }, { "$ref": "#/$defs/completedEvent" }, { "$ref": "#/$defs/failedEvent" }, { "$ref": "#/$defs/cancelledEvent" }] },
    "sourceMapping": { "type": "object", "additionalProperties": false, "required": ["adapterInstanceId", "resumeEpoch", "sourceRunId", "sourceEventId", "sourceSequence", "sourceEventType", "sourcePayloadDigest", "sourceSchemaVersion", "sourceCanonicalizationVersion", "hostRunId", "eventId", "hostSequence"], "properties": { "adapterInstanceId": { "$ref": "#/$defs/identity" }, "resumeEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "sourceRunId": { "$ref": "#/$defs/identity" }, "sourceEventId": { "$ref": "#/$defs/identity" }, "sourceSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "sourceEventType": { "enum": ["message.delta", "citation.declared", "cancel.acknowledged", "run.completed", "run.failed"] }, "sourcePayloadDigest": { "$ref": "#/$defs/sha256" }, "sourceSchemaVersion": { "const": "aaw.agent.source-event/v1alpha1" }, "sourceCanonicalizationVersion": { "const": "aaw-json-c14n/v1" }, "hostRunId": { "$ref": "#/$defs/identity" }, "eventId": { "$ref": "#/$defs/identity" }, "hostSequence": { "type": "integer", "minimum": 1, "maximum": 10000 } } },
    "retryFacts": { "type": "object", "additionalProperties": false, "required": ["runState", "errorCode", "reconfigureAuthorized", "policyAllowsNewRun", "noPendingOrUnknownSideEffects", "resumeCapabilityNegotiated", "cursorCurrentEpoch", "cursorLedgerVerified", "canonicalProgressExists", "sameRequestNotAcceptedOrIdempotent"], "properties": { "runState": { "enum": ["starting", "running", "cancelling", "terminal", "cancelled", "quarantined"] }, "errorCode": { "$ref": "#/$defs/errorCode" }, "reconfigureAuthorized": { "type": "boolean" }, "policyAllowsNewRun": { "type": "boolean" }, "noPendingOrUnknownSideEffects": { "type": "boolean" }, "resumeCapabilityNegotiated": { "type": "boolean" }, "cursorCurrentEpoch": { "type": "boolean" }, "cursorLedgerVerified": { "type": "boolean" }, "canonicalProgressExists": { "type": "boolean" }, "sameRequestNotAcceptedOrIdempotent": { "type": "boolean" } } },
    "toolTransition": { "oneOf": [
      { "$ref": "#/$defs/toolIdleRequested" }, { "$ref": "#/$defs/toolRequestedDenied" }, { "$ref": "#/$defs/toolRequestedApproved" }, { "$ref": "#/$defs/toolApprovedDispatched" }, { "$ref": "#/$defs/toolDispatchedSucceeded" }, { "$ref": "#/$defs/toolDispatchedFailed" }
    ] },
    "toolIdleRequested": { "type": "object", "additionalProperties": false, "required": ["from", "to", "toolBrokerInvocationCount"], "properties": { "from": { "const": "idle" }, "to": { "const": "requested" }, "toolBrokerInvocationCount": { "const": 0 } } },
    "toolRequestedDenied": { "type": "object", "additionalProperties": false, "required": ["from", "to", "toolBrokerInvocationCount"], "properties": { "from": { "const": "requested" }, "to": { "const": "denied" }, "toolBrokerInvocationCount": { "const": 0 } } },
    "toolRequestedApproved": { "type": "object", "additionalProperties": false, "required": ["from", "to", "toolBrokerInvocationCount"], "properties": { "from": { "const": "requested" }, "to": { "const": "approved" }, "toolBrokerInvocationCount": { "const": 0 } } },
    "toolApprovedDispatched": { "type": "object", "additionalProperties": false, "required": ["from", "to", "toolBrokerInvocationCount"], "properties": { "from": { "const": "approved" }, "to": { "const": "dispatched" }, "toolBrokerInvocationCount": { "const": 0 } } },
    "toolDispatchedSucceeded": { "type": "object", "additionalProperties": false, "required": ["from", "to", "toolBrokerInvocationCount"], "properties": { "from": { "const": "dispatched" }, "to": { "const": "succeeded" }, "toolBrokerInvocationCount": { "const": 0 } } },
    "toolDispatchedFailed": { "type": "object", "additionalProperties": false, "required": ["from", "to", "toolBrokerInvocationCount"], "properties": { "from": { "const": "dispatched" }, "to": { "const": "failed" }, "toolBrokerInvocationCount": { "const": 0 } } }
  }
}
