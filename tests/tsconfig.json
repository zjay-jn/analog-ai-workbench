    "moduleResolution": "Node16",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "rootDir": "..",
    "outDir": "../.local/test-build"
  },
  "include": [
    "**/*.test.ts",
